# ────────────────────────────────────────────────────────────────────────────
# QuizMaster Pro — Environment Variables
# Copy this file to `.env` (local dev) or set these in Vercel project settings.
# ────────────────────────────────────────────────────────────────────────────

# Database (Prisma)
# LOCAL DEV (SQLite): a file path on disk
DATABASE_URL="file:./db/custom.db"
# PRODUCTION (Vercel): use a hosted Postgres connection string
#   DATABASE_URL="postgresql://user:pass@host:5432/quizmaster?schema=public"
# Recommended providers: Neon (free), Supabase (free), Vercel Postgres, Railway.

# NextAuth (required)
NEXTAUTH_URL="http://localhost:3000"
# Generate a strong secret: `openssl rand -base64 32` or `bun -e 'console.log(crypto.randomBytes(32).toString("hex"))'`
NEXTAUTH_SECRET="change-me-to-a-strong-random-string"
# NextAuth v5 alias (optional but recommended)
AUTH_SECRET="change-me-to-a-strong-random-string"

# Admin emails — comma-separated, case-insensitive. Anyone who signs in with
# one of these emails is granted ADMIN role (and can access the admin panel).
ADMIN_EMAILS="admin@quizmaster.pro"

# Google OAuth (optional — leave blank to use email-based demo auth)
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Set the authorized redirect URI to: https://YOUR_DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Frontend flag — set to "true" to show the "Continue with Google" button.
# Only enable when GOOGLE_CLIENT_ID / SECRET are set.
NEXT_PUBLIC_GOOGLE_ENABLED="false"
