# ────────────────────────────────────────────────────────────────────────────
# Engagio — Environment Variables
# Copy this file to `.env` (local dev) or set these in Vercel project settings.
# ────────────────────────────────────────────────────────────────────────────

# Database (REQUIRED — Neon PostgreSQL)
# 1. Go to https://neon.tech → Create a free project
# 2. Copy the connection string from the Neon dashboard
# 3. Paste it here (must include ?sslmode=require)
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# NextAuth (REQUIRED)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Super admin email (REQUIRED — permanent platform admin)
# When someone signs in (email or Google) with this email, they automatically
# get super admin access → Platform Admin panel. No separate login tab needed.
SUPERADMIN_EMAIL="superadmin@engagio.app"

# Admin emails — comma-separated (REQUIRED — org-level admins)
ADMIN_EMAILS="your-email@example.com"

# Base domain for subdomain routing (REQUIRED for production)
# On Vercel: use your deployment URL, e.g., engagio.vercel.app
BASE_DOMAIN="localhost:3000"

# Payment encryption key (REQUIRED — for encrypting provider credentials)
# Generate a random string: openssl rand -base64 32
PAYMENT_ENCRYPTION_KEY="change-me-to-a-random-string"

# Google OAuth (optional — leave blank to use email-based demo auth)
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudinary (optional — falls back to base64 if not set)
# Get these from https://cloudinary.com/console:
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (optional — emails are skipped if not set)
# Get your API key from https://resend.com/api-keys:
RESEND_API_KEY=""
EMAIL_FROM="Engagio <noreply@yourdomain.com>"
