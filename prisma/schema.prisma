// QuizMaster Pro - Prisma schema
// Portable across SQLite (dev) and Postgres (Vercel prod)
// Note: SQLite doesn't support String[] arrays, so we store options/extras as Json.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  image         String?
  role          String   @default("STUDENT") // ADMIN | STUDENT
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts       Account[]
  sessions       Session[]
  attempts       QuizAttempt[]
  registrations  Registration[]
  certificates   Certificate[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String
  image       String?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  requireRegistration Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ---- Payment Configuration ----
  // FREE | RAZORPAY | STRIPE | MANUAL
  paymentMethod        String   @default("FREE")
  paymentAmount        Int      @default(0) // in smallest currency unit (paise for INR)
  paymentCurrency      String   @default("INR")
  paymentInstructions  String?  // shown to student before payment
  upiId                String?  // e.g. event@upi
  upiLink              String?  // UPI intent link
  qrCodeUrl            String?  // base64 data URL or external URL
  requireTransactionRef Boolean @default(true)
  requireScreenshot    Boolean  @default(true)

  // ---- Certificate Configuration ----
  certEnabled          Boolean  @default(false)
  certTemplate         String   @default("modern") // classic|modern|elegant|bold|minimal
  certIssueCondition   String   @default("COMPLETED") // PARTICIPATION|COMPLETED|PASSED
  certPassingScore     Int      @default(60)
  certOrgName          String?
  certSigneeName       String?
  certSigneeTitle      String?
  certSigneeImage      String?  // base64 data URL of signature image
  certLogo            String?  // base64 data URL of org logo

  questions      Question[]
  quizLinks      QuizLink[]
  attempts       QuizAttempt[]
  fields         EventField[]
  registrations  Registration[]
  certificates   Certificate[]
}

model Question {
  id            String   @id @default(cuid())
  eventId       String
  question      String
  type          String   @default("MCQ") // MCQ | TRUE_FALSE | FILL_BLANK | MATCHING | CODING
  options       String   // JSON-encoded string[] of options
  correctAnswer Int      @default(0)
  correctText   String?
  matchPairs    String?
  codeLanguage  String?
  marks         Int      @default(1)
  negativeMarks Int      @default(0)
  category      String?
  order         Int      @default(0)
  explanation   String?
  // NEW: optional question image (base64 data URL — lightweight, no external storage)
  imageUrl      String?
  // NEW: difficulty for filtering/analysis
  difficulty    String   @default("MEDIUM") // EASY | MEDIUM | HARD
  // NEW: tags for flexible labeling (JSON string[])
  tags          String?  // JSON-encoded string[]
  createdAt     DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([category])
}

model QuizLink {
  id              String   @id @default(cuid())
  eventId         String
  slug            String   @unique
  isActive        Boolean  @default(true)
  shuffleQuestions Boolean @default(true)
  shuffleOptions  Boolean  @default(false)
  timeLimit       Int      @default(30) // minutes; 0 = no limit
  maxAttempts     Int      @default(1) // 0 = unlimited
  // If > 0, pick this many questions randomly from the event's question bank
  // (instead of using all questions). 0 = use all.
  questionCount   Int      @default(0)
  showResults     Boolean  @default(true)
  // When false, results are hidden until an admin publishes them
  // (publishQuizLink / publish endpoint sets publishedAt on each attempt).
  publishResults  Boolean  @default(false)
  passThreshold   Int      @default(40) // percentage

  // ---- Security toggles (all per-quiz-link) ----
  requireFullscreen    Boolean @default(true)
  autoSubmitOnExit     Boolean @default(true) // auto-submit when fullscreen exited
  tabSwitchDetection   Boolean @default(true)
  copyPasteBlocking    Boolean @default(true)
  rightClickDisable    Boolean @default(true)
  keyboardShortcutBlocking Boolean @default(true)
  devtoolsDetection    Boolean @default(true)
  antiScreenshot       Boolean @default(true)
  watermarkOverlay     Boolean @default(true)
  // AI Proctor master toggle + 4 sub-toggles
  aiProctor            Boolean @default(false)
  aiProctorFaceDetection Boolean @default(true)
  aiProctorMultiFace   Boolean @default(true)
  aiProctorLookAway    Boolean @default(true)

  createdAt       DateTime @default(now())
  expiresAt       DateTime?

  event    Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attempts QuizAttempt[]

  @@index([eventId])
}

model QuizAttempt {
  id              String   @id @default(cuid())
  userId          String
  quizLinkId      String
  eventId         String
  answers         String?  // JSON-encoded { questionId: selectedIndex | string | {left:right} }
  score           Int?
  totalMarks      Int?
  percentage      Int?
  passed          Boolean?
  // Anti-cheat violation counters (sent on submit)
  tabSwitches     Int      @default(0)
  fullscreenExits Int      @default(0)
  copyAttempts    Int      @default(0)
  rightClicks     Int      @default(0)
  devtoolsOpen    Int      @default(0)
  screenshotAttempts Int   @default(0)
  keyboardViolations Int   @default(0)
  // AI Proctor violation counts (if aiProctor enabled)
  faceNotDetected Int      @default(0)
  multiFaceAlerts Int      @default(0)
  lookAwayAlerts  Int      @default(0)
  timeTaken       Int?     // seconds
  questionOrder   String?  // JSON-encoded questionId[]
  // JSON-encoded string[] of questionIds the student flagged for review
  flaggedQuestions String?
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  // When null, the attempt's results are hidden from the student (if the
  // quiz link has publishResults=true). Admin sets this via the publish endpoint.
  publishedAt     DateTime?
  status          String   @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | CHEAT_DETECTED | TIMEOUT
  ipAddress       String?
  userAgent       String?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizLink  QuizLink  @relation(fields: [quizLinkId], references: [id], onDelete: Cascade)
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quizLinkId])
  @@index([eventId])
}

// Dynamic registration form field — admin defines these per event.
// Rendered as an HTML input of the matching `type`.
model EventField {
  id          String   @id @default(cuid())
  eventId     String
  label       String   // Human label, e.g. "Full Name"
  type        String   // text | email | number | tel | textarea | select | checkbox | date
  required    Boolean  @default(true)
  placeholder String?
  helpText    String?
  // JSON-encoded string[] — only used for `select` type (dropdown options).
  options     String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// One registration per (event, user). `data` stores the submitted answers
// as JSON: { [fieldId]: string | number | boolean }
// Also tracks manual payment verification status.
model Registration {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  data      String   // JSON-encoded { [fieldId]: value }
  createdAt DateTime @default(now())

  // ---- Payment tracking (for MANUAL payment mode) ----
  // NONE | PENDING_VERIFICATION | COMPLETED | REJECTED
  paymentStatus        String   @default("NONE")
  paymentMethod        String?  // MANUAL | RAZORPAY | STRIPE
  transactionReference String?  // UTR / transaction ID entered by student
  screenshotUrl        String?  // base64 data URL of payment screenshot
  verifiedBy           String?  // admin userId who approved/rejected
  verifiedAt           DateTime?
  rejectionReason      String?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([paymentStatus])
}

// Certificate issued to a participant. certificateNumber is human-readable
// (e.g. EVT-2026-A8F42K). verificationToken is a separate long random string
// used in the public verification URL (/?verify=TOKEN).
model Certificate {
  id                String   @id @default(cuid())
  eventId           String
  userId            String
  attemptId         String?
  certificateNumber String   @unique // e.g. EVT-2026-A8F42K
  verificationToken String   @unique // 32-char hex for /verify/[token]
  template          String   @default("modern") // classic|modern|elegant|bold|minimal
  recipientName     String
  issuedAt          DateTime @default(now())
  status            String   @default("VALID") // VALID | REVOKED
  certificateUrl    String?  // optional: generated PNG data URL (can be regenerated)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([userId])
}
