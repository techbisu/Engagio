// QuizMaster Pro - Prisma schema
// Portable across SQLite (dev) and Postgres (Vercel prod)
// Note: SQLite doesn't support String[] arrays, so we store options/extras as Json.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  image         String?
  role          String   @default("STUDENT") // ADMIN | STUDENT
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  attempts      QuizAttempt[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String
  image       String?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions   Question[]
  quizLinks   QuizLink[]
  attempts    QuizAttempt[]
}

model Question {
  id            String   @id @default(cuid())
  eventId       String
  question      String
  options       String   // JSON-encoded string[] of options
  correctAnswer Int     // index into options
  marks         Int      @default(1)
  order         Int      @default(0)
  explanation   String?
  createdAt     DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model QuizLink {
  id              String   @id @default(cuid())
  eventId         String
  slug            String   @unique
  isActive        Boolean  @default(true)
  shuffleQuestions Boolean @default(true)
  shuffleOptions  Boolean  @default(false)
  timeLimit       Int      @default(30) // minutes; 0 = no limit
  maxAttempts     Int      @default(1) // 0 = unlimited
  showResults     Boolean  @default(true)
  passThreshold   Int      @default(40) // percentage
  requireFullscreen Boolean @default(true)
  createdAt       DateTime @default(now())
  expiresAt       DateTime?

  event    Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attempts QuizAttempt[]

  @@index([eventId])
}

model QuizAttempt {
  id              String   @id @default(cuid())
  userId          String
  quizLinkId      String
  eventId         String
  answers         String?  // JSON-encoded { questionId: selectedIndex }
  score           Int?
  totalMarks      Int?
  percentage      Int?
  passed          Boolean?
  tabSwitches     Int      @default(0)
  fullscreenExits Int      @default(0)
  copyAttempts    Int      @default(0)
  rightClicks     Int      @default(0)
  timeTaken       Int?     // seconds
  questionOrder   String?  // JSON-encoded questionId[]
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  status          String   @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | CHEAT_DETECTED | TIMEOUT
  ipAddress       String?
  userAgent       String?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizLink  QuizLink  @relation(fields: [quizLinkId], references: [id], onDelete: Cascade)
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quizLinkId])
  @@index([eventId])
}
