// Engagio - Prisma schema
// For local dev: SQLite (DATABASE_URL=file:./db/custom.db)
// For Vercel:   PostgreSQL (DATABASE_URL=postgresql://...)
// The vercel.json buildCommand runs a script that auto-switches the provider
// based on whether DATABASE_URL starts with "postgresql://" or "file:".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  image         String?
  role          String   @default("STUDENT") // ADMIN | STUDENT
  // Password hash (bcrypt) — null for Google-only users + participants
  passwordHash  String?
  // i18n: user's preferred locale (falls back to org locale, then 'en')
  locale        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts       Account[]
  sessions       Session[]
  attempts       QuizAttempt[]
  registrations  Registration[]
  certificates   Certificate[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String
  image       String?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  requireRegistration Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ---- Payment Configuration ----
  // FREE | RAZORPAY | STRIPE | MANUAL
  paymentMethod        String   @default("FREE")
  paymentAmount        Int      @default(0) // in smallest currency unit (paise for INR)
  paymentCurrency      String   @default("INR")
  paymentInstructions  String?  // shown to student before payment
  upiId                String?  // e.g. event@upi
  upiLink              String?  // UPI intent link
  qrCodeUrl            String?  // base64 data URL or external URL
  qrCodePublicId       String?  // Cloudinary public_id for deletion/migration
  requireTransactionRef Boolean @default(true)
  requireScreenshot    Boolean  @default(true)

  // ---- Certificate Configuration ----
  certEnabled          Boolean  @default(false)
  certTemplate         String   @default("modern") // classic|modern|elegant|bold|minimal
  certIssueCondition   String   @default("COMPLETED") // PARTICIPATION|COMPLETED|PASSED
  certPassingScore     Int      @default(60)
  // NEW: auto-generate certificates when participant becomes eligible
  // (after result is shown immediately OR after admin publishes result)
  certAutoGenerate     Boolean  @default(false)
  certOrgName          String?
  certSigneeName       String?
  certSigneeTitle      String?
  certSigneeImage      String?  // Cloudinary URL (or base64 fallback)
  certSigneeImagePublicId String? // Cloudinary public_id for deletion
  certLogo            String?  // Cloudinary URL (or base64 fallback)
  certLogoPublicId    String? // Cloudinary public_id for deletion

  // Multi-tenant: nullable for backward compat (existing events get backfilled
  // to a Default Organization by the migration script).
  organizationId      String?
  organization         Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  questions      Question[]
  quizLinks      QuizLink[]
  attempts       QuizAttempt[]
  fields         EventField[]
  registrations  Registration[]
  certificates   Certificate[]
  activities     Activity[]
}

model Question {
  id            String   @id @default(cuid())
  eventId       String
  question      String
  type          String   @default("MCQ") // MCQ | TRUE_FALSE | FILL_BLANK | MATCHING | CODING
  options       String   // JSON-encoded string[] of options
  correctAnswer Int      @default(0)
  correctText   String?
  matchPairs    String?
  codeLanguage  String?
  marks         Int      @default(1)
  negativeMarks Int      @default(0)
  category      String?
  order         Int      @default(0)
  explanation   String?
  // Optional question image (Cloudinary URL, or base64 fallback when Cloudinary not configured)
  imageUrl      String?
  imageUrlPublicId String? // Cloudinary public_id for deletion/migration
  // Difficulty for filtering/analysis
  difficulty    String   @default("MEDIUM") // EASY | MEDIUM | HARD
  // Tags for flexible labeling (JSON string[])
  tags          String?  // JSON-encoded string[]
  createdAt     DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Multi-tenant: nullable for backward compat. When set, the question belongs
  // to the org's question bank (reusable across events in the same org).
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([category])
  @@index([organizationId])
}

model QuizLink {
  id              String   @id @default(cuid())
  eventId         String
  slug            String   @unique
  isActive        Boolean  @default(true)
  shuffleQuestions Boolean @default(true)
  shuffleOptions  Boolean  @default(false)
  timeLimit       Int      @default(30) // minutes; 0 = no limit
  maxAttempts     Int      @default(1) // 0 = unlimited
  // If > 0, pick this many questions randomly from the event's question bank
  // (instead of using all questions). 0 = use all.
  questionCount   Int      @default(0)
  showResults     Boolean  @default(true)
  // When true, results are hidden until an admin publishes them
  // (publishQuizLink / publish endpoint sets publishedAt on each attempt).
  // This is the "Result Visibility" setting: showResults=true = immediate, false = publish later.
  publishResults  Boolean  @default(false)
  // NEW: send email notification to participant when results are published.
  // Independent of publishResults — only fires when publishing actually happens.
  emailOnPublish     Boolean  @default(true)
  // NEW: enable the public leaderboard for this quiz link.
  // Independent of result visibility.
  leaderboardEnabled Boolean  @default(true)
  passThreshold   Int      @default(40) // percentage

  // ---- Security toggles (all per-quiz-link) ----
  requireFullscreen    Boolean @default(true)
  autoSubmitOnExit     Boolean @default(true) // auto-submit when fullscreen exited
  tabSwitchDetection   Boolean @default(true)
  copyPasteBlocking    Boolean @default(true)
  rightClickDisable    Boolean @default(true)
  keyboardShortcutBlocking Boolean @default(true)
  devtoolsDetection    Boolean @default(true)
  antiScreenshot       Boolean @default(true)
  watermarkOverlay     Boolean @default(true)
  // AI Proctor master toggle + 4 sub-toggles
  aiProctor            Boolean @default(false)
  aiProctorFaceDetection Boolean @default(true)
  aiProctorMultiFace   Boolean @default(true)
  aiProctorLookAway    Boolean @default(true)

  createdAt       DateTime @default(now())
  expiresAt       DateTime?

  event    Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attempts QuizAttempt[]

  @@index([eventId])
}

model QuizAttempt {
  id              String   @id @default(cuid())
  userId          String
  quizLinkId      String
  eventId         String
  answers         String?  // JSON-encoded { questionId: selectedIndex | string | {left:right} }
  score           Int?
  totalMarks      Int?
  percentage      Int?
  passed          Boolean?
  // Anti-cheat violation counters (sent on submit)
  tabSwitches     Int      @default(0)
  fullscreenExits Int      @default(0)
  copyAttempts    Int      @default(0)
  rightClicks     Int      @default(0)
  devtoolsOpen    Int      @default(0)
  screenshotAttempts Int   @default(0)
  keyboardViolations Int   @default(0)
  // AI Proctor violation counts (if aiProctor enabled)
  faceNotDetected Int      @default(0)
  multiFaceAlerts Int      @default(0)
  lookAwayAlerts  Int      @default(0)
  timeTaken       Int?     // seconds
  questionOrder   String?  // JSON-encoded questionId[]
  // JSON-encoded string[] of questionIds the student flagged for review
  flaggedQuestions String?
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  // When null, the attempt's results are hidden from the student (if the
  // quiz link has publishResults=true). Admin sets this via the publish endpoint.
  publishedAt     DateTime?
  status          String   @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | CHEAT_DETECTED | TIMEOUT
  ipAddress       String?
  userAgent       String?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizLink  QuizLink  @relation(fields: [quizLinkId], references: [id], onDelete: Cascade)
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quizLinkId])
  @@index([eventId])
}

// Dynamic registration form field — admin defines these per event.
// Rendered as an HTML input of the matching `type`.
model EventField {
  id          String   @id @default(cuid())
  eventId     String
  label       String   // Human label, e.g. "Full Name"
  type        String   // text | email | number | tel | textarea | select | checkbox | date
  required    Boolean  @default(true)
  placeholder String?
  helpText    String?
  // JSON-encoded string[] — only used for `select` type (dropdown options).
  options     String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// One registration per (event, user). `data` stores the submitted answers
// as JSON: { [fieldId]: string | number | boolean }
// Also tracks manual payment verification status.
model Registration {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  data      String   // JSON-encoded { [fieldId]: value }
  createdAt DateTime @default(now())

  // ---- Payment tracking (for MANUAL payment mode) ----
  // NONE | PENDING_VERIFICATION | COMPLETED | REJECTED
  paymentStatus        String   @default("NONE")
  paymentMethod        String?  // MANUAL | RAZORPAY | STRIPE
  transactionReference String?  // UTR / transaction ID entered by student
  screenshotUrl        String?  // base64 data URL of payment screenshot
  verifiedBy           String?  // admin userId who approved/rejected
  verifiedAt           DateTime?
  rejectionReason      String?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([paymentStatus])
}

// Certificate issued to a participant. certificateNumber is human-readable
// (e.g. EVT-2026-A8F42K). verificationToken is a separate long random string
// used in the public verification URL (/?verify=TOKEN).
model Certificate {
  id                String   @id @default(cuid())
  eventId           String
  userId            String
  attemptId         String?
  certificateNumber String   @unique // e.g. EVT-2026-A8F42K
  verificationToken String   @unique // 32-char hex for /verify/[token]
  template          String   @default("modern") // classic|modern|elegant|bold|minimal
  // How this certificate was issued — PARTICIPATION | COMPLETED | PASSED
  eligibilityType   String   @default("COMPLETED")
  recipientName     String
  issuedAt          DateTime @default(now())
  issuedBy          String?  // admin userId who issued (null if auto-generated)
  status            String   @default("VALID") // VALID | REVOKED
  // Cloudinary storage for the generated PNG (URL + public_id for deletion/migration)
  certificateUrl    String?  // Cloudinary URL (or base64 fallback when not configured)
  certificatePublicId String? // Cloudinary public_id
  // Generation provenance
  generatedAutomatically Boolean @default(false) // true if auto-generated, false if manual
  manualOverride    Boolean  @default(false) // true if admin overrode eligibility
  // Revocation tracking
  revokedAt         DateTime?
  revokedBy         String?  // admin userId who revoked
  revocationReason  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([userId])
}

// ────────────────────────────────────────────────────────────────────────────
// ACTIVITY SYSTEM — extensible activity types per event
// The existing Quiz/Assessment system (QuizLink → QuizAttempt) remains intact.
// For QUIZ-type activities, `quizLinkId` links the Activity to the existing
// assessment. For other types (POLL, SURVEY, Q_AND_A, VOTING, etc.), the
// ActivityQuestion + ActivityResponse models below handle the data.
// ────────────────────────────────────────────────────────────────────────────

model Activity {
  id          String   @id @default(cuid())
  eventId     String
  // QUIZ | LIVE_QUIZ | POLL | SURVEY | FEEDBACK | Q_AND_A | VOTING | KNOWLEDGE_CHECK | PRE_POST_ASSESSMENT
  type        String   @default("POLL")
  title       String
  description String?
  // DRAFT | SCHEDULED | LIVE | CLOSED | COMPLETED
  status      String   @default("DRAFT")
  isEnabled   Boolean  @default(true)
  sortOrder   Int      @default(0)
  // Optional scheduling
  startsAt    DateTime?
  endsAt      DateTime?
  // JSON: type-specific settings (e.g., { allowMultiple: true, anonymous: true, showResults: true })
  settings    String   @default("{}")
  // For QUIZ type: links to the existing QuizLink (nullable — most types don't use this)
  quizLinkId  String?
  // Optional session grouping (just a string label for MVP — not a separate model)
  session     String?
  // QR/shareable short code for participant access
  slug        String?  @unique
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  questions    ActivityQuestion[]
  responses    ActivityResponse[]
  participations ActivityParticipation[]

  @@index([eventId])
  @@index([type])
  @@index([status])
}

// Questions for non-quiz activities (polls, surveys, Q&A, voting).
// For QUIZ-type activities, the existing Question model is used via quizLinkId.
model ActivityQuestion {
  id          String   @id @default(cuid())
  activityId  String
  text        String
  // For polls/surveys: "SINGLE_CHOICE" | "MULTIPLE_CHOICE" | "RATING" | "TEXT" | "NUMBER" | "YES_NO"
  // For Q&A: "OPEN" (free-text question submission)
  // For voting: "SINGLE_CHOICE" (the candidates)
  type        String   @default("SINGLE_CHOICE")
  // JSON string[] of options (for choice-based types)
  options     String?
  required    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  activity   Activity           @relation(fields: [activityId], references: [id], onDelete: Cascade)
  responses  ActivityResponse[]

  @@index([activityId])
}

// Individual participant responses to activity questions.
// For Q&A: the `text` field holds the submitted question, and `metadata` holds upvotes.
// For polls/voting: `selectedOptions` holds the chosen option indices.
// For surveys: `selectedOptions`, `text`, `numberValue`, or `ratingValue` depending on question type.
model ActivityResponse {
  id              String   @id @default(cuid())
  activityId      String
  questionId      String?
  participantId   String?
  participantName String?  // for anonymous responses
  // The response payload — which fields are used depends on the activity type + question type
  selectedOptions String?  // JSON number[] of option indices
  text            String?  // for TEXT / OPEN (Q&A) questions
  numberValue     Int?
  ratingValue     Int?     // 1-5 for RATING questions
  // Metadata JSON (e.g., { upvotes: 5, approved: true, pinned: false, status: "PENDING" })
  metadata        String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  activity   Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  question   ActivityQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@index([activityId])
  @@index([questionId])
  @@index([participantId])
}

// Lightweight participation tracking (which participant joined which activity).
// Does NOT duplicate quiz attempts — QUIZ activities use QuizAttempt.
model ActivityParticipation {
  id            String   @id @default(cuid())
  activityId    String
  participantId String
  // STARTED | COMPLETED | ABANDONED
  status        String   @default("STARTED")
  startedAt     DateTime @default(now())
  completedAt   DateTime?

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, participantId])
  @@index([activityId])
  @@index([participantId])
}

// ────────────────────────────────────────────────────────────────────────────
// MULTI-TENANT SAAS — Organization, Membership, Audit, Plans
// All org-owned resources (Event, Question) carry a nullable `organizationId`.
// Nullable = backward-compatible (existing data gets backfilled to a Default Org).
// Other resources (Activity, QuizLink, QuizAttempt, Registration, Certificate)
// inherit org scope transitively from their Event.
// ────────────────────────────────────────────────────────────────────────────

model Organization {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  // Branding
  logoUrl       String?
  logoPublicId  String?
  website       String?
  email         String?
  phone         String?
  primaryColor  String   @default("#10b981")
  secondaryColor String  @default("#14b8a6")
  // Settings
  timezone      String   @default("UTC")
  locale        String   @default("en")
  // ACTIVE | SUSPENDED | ARCHIVED
  status        String   @default("ACTIVE")
  // Industry/use-case tag (Medical | Education | Corporate | Training | Professional Association | NGO | Other)
  industry      String?
  // SaaS billing (future-ready stubs)
  planId        String?
  // Multi-currency: org's preferred billing currency (INR | USD | EUR | GBP)
  billingCurrency String  @default("INR")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members       OrganizationMember[]
  invitations   OrganizationInvitation[]
  auditLogs     AuditLog[]
  events        Event[]
  questions     Question[]
  domains       OrganizationDomain[]
  paymentConfigs PaymentProviderConfig[]

  @@index([status])
}

// Custom + subdomain management for an organization.
// Subdomains ({slug}.engagio.com) are auto-created. Custom domains
// (events.abcmedical.org) require DNS verification + a paid plan.
model OrganizationDomain {
  id              String   @id @default(cuid())
  organizationId  String
  domain          String   @unique // e.g. "abcmedical.engagio.com" or "events.abcmedical.org"
  // SUBDOMAIN | CUSTOM_DOMAIN
  type            String   @default("SUBDOMAIN")
  isPrimary       Boolean  @default(false)
  // PENDING | VERIFYING | VERIFIED | ACTIVE | FAILED | DISABLED
  status          String   @default("PENDING")
  // For custom domains: DNS verification token + records
  verificationToken String?
  verifiedAt      DateTime?
  lastCheckedAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
}

model OrganizationMember {
  id              String   @id @default(cuid())
  organizationId  String
  userId          String
  // OWNER | ADMIN | EVENT_MANAGER | MODERATOR | EVALUATOR | CHECKIN_STAFF | PARTICIPANT
  role            String   @default("PARTICIPANT")
  // ACTIVE | INVITED | SUSPENDED
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model OrganizationInvitation {
  id              String   @id @default(cuid())
  organizationId  String
  email           String
  role            String   @default("EVENT_MANAGER")
  // PENDING | ACCEPTED | EXPIRED | CANCELLED
  status          String   @default("PENDING")
  token           String   @unique
  invitedBy       String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([status])
}

model AuditLog {
  id              String   @id @default(cuid())
  organizationId  String
  userId          String?
  action          String   // e.g. EVENT_CREATED, MEMBER_INVITED, PAYMENT_VERIFIED
  entityType      String?  // Event | Question | Member | Payment | Certificate | etc.
  entityId        String?
  metadata        String   @default("{}") // JSON
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([action])
}

// Future-ready SaaS billing stubs (not fully implemented — just the models)
model Plan {
  id              String   @id @default(cuid())
  name            String   @unique // FREE | STARTER | PROFESSIONAL | ENTERPRISE
  displayName     String
  // JSON: { maxEvents, maxParticipantsPerEvent, maxMembers, maxStorage, customBranding, certificates, advancedSecurity, aiProctor, customDomain }
  limits          String   @default("{}")
  // Legacy single-price fields (kept for backward compat — prefer PlanPrice)
  priceMonthly    Int      @default(0) // in paise
  priceYearly     Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  subscriptions Subscription[]
  prices        PlanPrice[]
}

// Multi-currency plan pricing. Each plan can have prices in multiple currencies.
// Money is stored as integer minor units (paise for INR, cents for USD, etc.).
model PlanPrice {
  id              String   @id @default(cuid())
  planId          String
  // INR | USD | EUR | GBP | AUD | CAD
  currency        String
  // Integer minor units (e.g. 49900 = ₹499.00, 999 = $9.99)
  monthlyAmount   Int      @default(0)
  yearlyAmount    Int      @default(0)
  // Optional: provider-specific price IDs for future payment integration
  monthlyPriceId  String?
  yearlyPriceId   String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, currency])
  @@index([currency])
}

model Subscription {
  id              String   @id @default(cuid())
  organizationId  String
  planId          String
  // ACTIVE | PAST_DUE | CANCELED | TRIALING
  status          String   @default("ACTIVE")
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  plan Plan @relation(fields: [planId], references: [id])

  @@index([organizationId])
}

// ────────────────────────────────────────────────────────────────────────────
// SHAREABLE ACHIEVEMENT CARDS — social-media-ready cards for participant achievements
// Reuses existing Activities/Assessments/Certificates data. The card is a
// presentation/share layer on top — no duplicate result/attempt data.
// ────────────────────────────────────────────────────────────────────────────

model ShareableAchievement {
  id              String   @id @default(cuid())
  organizationId String
  eventId         String?
  activityId      String?

  // The participant who earned this achievement (user.id).
  // Null for guest/anonymous participants (rare).
  participantId   String?
  // Display name snapshot at creation time (in case user later changes name)
  participantName String

  // QUIZ_RESULT | LIVE_QUIZ_RESULT | KNOWLEDGE_CHECK_RESULT | PRE_POST_RESULT |
  // CERTIFICATE_EARNED | ACTIVITY_COMPLETED | EVENT_PARTICIPATION | LEADERBOARD_ACHIEVEMENT
  type            String

  // Card content (snapshot at creation time)
  title           String
  subtitle        String?
  score           Int?     // raw score
  totalScore      Int?     // out of
  percentage      Int?
  rank            Int?     // 1-based
  totalParticipants Int?
  // Extra JSON: { beforeScore, afterScore, improvement, certificateNumber, certificateUrl, ... }
  achievementData String   @default("{}")

  // Public share token (32-char hex) — non-sequential, hard to guess
  publicToken     String   @unique

  // PRIVATE | LINK_ONLY | PUBLIC
  visibility      String   @default("LINK_ONLY")

  // Generated card image (Cloudinary URL or base64 fallback)
  imageUrl        String?
  imagePublicId   String?

  // Card template: minimal | modern | professional | celebration | conference
  templateId      String   @default("modern")

  // Optional link to a related certificate
  certificateId   String?

  // Bumping this invalidates cached images (forces regeneration)
  dataVersion     Int      @default(1)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  shares          AchievementShare[]

  @@index([organizationId])
  @@index([participantId])
  @@index([activityId])
  @@index([publicToken])
}

// Lightweight share analytics — tracks which platform was used.
model AchievementShare {
  id              String   @id @default(cuid())
  organizationId  String
  achievementId   String

  // NATIVE | WHATSAPP | LINKEDIN | FACEBOOK | X | COPY_LINK | DOWNLOAD
  platform        String

  createdAt       DateTime @default(now())

  achievement     ShareableAchievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([achievementId])
  @@index([platform])
}

// ────────────────────────────────────────────────────────────────────────────
// ORGANIZATION PAYMENT PROVIDER CONFIG — per-org payment gateway credentials
// Separates SaaS billing (Org → Engagio) from event registration payments
// (Participant → Org's event). Credentials are encrypted at rest.
// ────────────────────────────────────────────────────────────────────────────

model PaymentProviderConfig {
  id              String   @id @default(cuid())
  organizationId  String

  // RAZORPAY | STRIPE | MANUAL | CASHFREE | PAYPAL | OTHER
  provider        String
  // The type of integration (e.g. "STANDARD", "CONNECTED_ACCOUNT")
  type            String   @default("STANDARD")

  status          String   @default("ACTIVE") // ACTIVE | DISABLED

  displayName     String   @default("Default")

  // Encrypted credentials JSON — never store secrets in plaintext.
  // The server decrypts these only when making API calls to the provider.
  // Format: { apiKey: "encrypted...", secretKey: "encrypted...", webhookSecret: "encrypted..." }
  credentialsEncrypted String

  // Non-sensitive settings (e.g. { testMode: true, region: "in" })
  settings        String   @default("{}")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([provider])
}
